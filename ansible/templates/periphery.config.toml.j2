# Managed by Ansible (ansible/komodo.yml) -- local edits are overwritten.

## Root directory for Periphery-managed resources (stacks, repos, keys).
root_directory = "{{ komodo_root_directory }}"

## Outbound mode: this agent dials Core over the tailnet; Core never reaches
## this host, so the inbound server on port 8120 stays disabled.
## Env: PERIPHERY_CORE_ADDRESS
core_address = "{{ komodo_core_address }}"

## The Komodo Server this agent connects as (== the tailnet hostname).
## Env: PERIPHERY_CONNECT_AS
connect_as = "{{ inventory_hostname }}"

## Reusable Server Onboarding Key (Komodo UI -> Servers -> Onboarding Keys).
## Only used until the Server exists; steady-state auth is the keypair in
## {{ komodo_root_directory }}/keys/. Deliberately left on disk afterwards (unused):
## removing it is a manual edit, and re-onboarding a deleted Server would then
## need a fresh key.  Env: PERIPHERY_ONBOARDING_KEY
onboarding_key = "{{ komodo_onboarding_key }}"

## Terminals and container exec are enabled by default; set these true to disable:
# disable_terminals = false
# disable_container_terminals = false
